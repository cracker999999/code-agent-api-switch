<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="APISwitch.UI.App"
             Name="APISwitch"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />

    <Style Selector="ScrollViewer">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>

    <Style Selector="ScrollBar:vertical">
      <Setter Property="Width" Value="12" />
      <Setter Property="MinWidth" Value="12" />
      <Setter Property="MaxWidth" Value="12" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ScrollBar:horizontal">
      <Setter Property="Height" Value="12" />
      <Setter Property="MinHeight" Value="12" />
      <Setter Property="MaxHeight" Value="12" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 隐藏滚动条两端的箭头按钮，使滑块可以到达轨道顶端和底端 -->
    <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Height" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="0" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton#PART_LineDownButton">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Height" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="0" />
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- 滑块最小尺寸，避免内容过长时滑块被压缩到难以拖动 -->
    <Style Selector="ScrollBar:vertical /template/ Thumb">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb">
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb /template/ Border">
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="#B0B8C4" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb /template/ Border">
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="#B0B8C4" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover /template/ Border">
      <Setter Property="Background" Value="#8A94A6" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb:pointerover /template/ Border">
      <Setter Property="Background" Value="#8A94A6" />
    </Style>
  </Application.Styles>
</Application>
