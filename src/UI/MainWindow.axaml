<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:APISwitch.Models;assembly=Core"
        xmlns:shapes="clr-namespace:Avalonia.Controls.Shapes;assembly=Avalonia.Controls"
        x:Class="APISwitch.UI.MainWindow"
        Title="APISwitch"
        Icon="/Assets/app.ico"
        Width="884"
        Height="600"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button.tab">
      <Setter Property="Width" Value="120" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.provider-card">
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.provider-card.active">
      <Setter Property="BorderBrush" Value="#2563EB" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.link-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Foreground" Value="#2563EB" />
    </Style>
    <Style Selector="Button.action-btn">
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.header-action">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#D1D5DB" />
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.plus-action">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#D1D5DB" />
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid Margin="16" Background="#F3F4F6" RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="CodexTabButton" Classes="tab" Click="CodexTabButton_Click" Content="Codex" />
        <Button x:Name="ClaudeTabButton" Classes="tab" Click="ClaudeTabButton_Click" Content="Claude Code" />
        <Button x:Name="GrokTabButton" Classes="tab" Click="GrokTabButton_Click" Content="Grok" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button x:Name="SessionManagerButton" Classes="header-action" Click="SessionManagerButton_Click" Content="会话管理" />
        <Button x:Name="PromptButton" Classes="header-action" Click="PromptButton_Click" Content="Prompt" />
        <Button x:Name="SettingsButton" Classes="plus-action" Click="SettingsButton_Click" ToolTip.Tip="设置" FontSize="18" Content="⚙" />
        <Button x:Name="AddProviderButton" Classes="plus-action" Click="AddProviderButton_Click">
          <Grid Width="14" Height="14">
            <Border Width="14"
                    Height="2"
                    Background="#111827"
                    CornerRadius="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            <Border Width="2"
                    Height="14"
                    Background="#111827"
                    CornerRadius="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
          </Grid>
        </Button>
      </StackPanel>
    </Grid>

    <TextBox Grid.Row="1"
             x:Name="SearchTextBox"
             Watermark="搜索供应商..."
             Margin="0,0,0,12"
             Height="36"
             Padding="12,8"
             CornerRadius="8"
             VerticalContentAlignment="Center"
             TextChanged="SearchTextBox_TextChanged" />

    <ScrollViewer x:Name="ProvidersScrollViewer"
                  Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Hidden"
                  Padding="0"
                  Margin="0">
      <ItemsControl x:Name="ProvidersItemsControl" Margin="0,0,4,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="models:Provider">
            <Border x:Name="ProviderCard"
                    Classes="provider-card"
                    Classes.active="{Binding IsActive}"
                    Margin="0,0,2,10"
                    PointerPressed="ProviderCard_PointerPressed">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="☰"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="#9CA3AF"
                           FontSize="16"
                           PointerPressed="ProviderDragHandle_PointerPressed"
                           PointerMoved="ProviderDragHandle_PointerMoved"
                           PointerReleased="ProviderDragHandle_PointerReleased"
                           PointerCaptureLost="ProviderDragHandle_PointerCaptureLost" />

                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="8" Height="8" Margin="0,0,4,0" VerticalAlignment="Center">
                      <shapes:Ellipse Fill="#22C55E" IsVisible="{Binding IsTestSuccess}" />
                      <shapes:Ellipse Fill="#EF4444" IsVisible="{Binding IsTestFailed}" />
                    </Grid>
                    <TextBlock Text="{Binding Name}"
                               FontSize="18"
                               FontWeight="{OnPlatform Default=Bold, macOS=SemiBold}"
                               FontFamily="{OnPlatform Default='Microsoft YaHei UI, Segoe UI', macOS='PingFang SC, Hiragino Sans GB, Noto Sans CJK SC'}"
                               Foreground="#111827" />
                    <TextBlock Text="{Binding Remark}"
                               Margin="8,0,0,0"
                               Foreground="#9CA3AF"
                               FontSize="11"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Classes="link-button" Click="BaseUrlButton_Click" Content="{Binding BaseUrl}" />
                    <TextBlock Text="{Binding TestModelDisplay}"
                               Margin="12,0,0,0"
                               Foreground="#9CA3AF"
                               FontSize="11"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Classes="action-btn"
                          Click="ActivateProviderButton_Click"
                          Content="{Binding ActivateButtonText}"
                          IsEnabled="{Binding !IsActive}" />
                  <Button Classes="action-btn" Click="TestProviderButton_Click" Content="测试" />
                  <Button Classes="action-btn" Click="EditProviderButton_Click" Content="编辑" />
                  <Button Classes="action-btn" Click="DeleteProviderButton_Click" Content="删除" />
                  <Button Classes="action-btn" Click="MoveProviderUpButton_Click" Content="↑" IsEnabled="{Binding CanMoveUp}" />
                  <Button Classes="action-btn" Click="MoveProviderDownButton_Click" Content="↓" IsEnabled="{Binding CanMoveDown}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- 拖拽时显示供应商的插入位置，不参与命中测试。 -->
    <Border Grid.Row="2"
            x:Name="ProviderDropInsertionIndicator"
            Height="2"
            Margin="2,0,18,0"
            VerticalAlignment="Top"
            Background="#2563EB"
            IsHitTestVisible="False"
            IsVisible="False" />
  </Grid>
</Window>
