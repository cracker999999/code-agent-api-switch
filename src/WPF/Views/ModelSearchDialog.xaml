<Window x:Class="WPF.Views.ModelSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:APISwitch.Models;assembly=Core"
        Title="查找模型"
        Width="680"
        Height="500"
        MinWidth="480"
        MinHeight="360"
        Background="#F3F4F6"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ModelIdTextBox"
                     Style="{StaticResource SearchTextBoxStyle}"
                     Tag="模型 ID"
                     AutomationProperties.Name="模型 ID" />
            <Button x:Name="SearchButton"
                    Grid.Column="1"
                    Width="80"
                    Height="36"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    Click="SearchButton_Click">查询</Button>
        </Grid>

        <TextBlock x:Name="ProgressTextBlock"
                   Grid.Row="1"
                   Margin="0,12,0,12"
                   Foreground="#6B7280"
                   TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ResultsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ModelSearchResult}">
                        <Border Margin="0,0,4,8"
                                Padding="12"
                                Background="White"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Provider.Name}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding ToolName}" Margin="12,0,0,0" Foreground="#6B7280" VerticalAlignment="Center" />
                                </Grid>
                                <TextBox Text="{Binding Provider.BaseUrl, Mode=OneWay}"
                                         Margin="0,4,0,0"
                                         Padding="0"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#6B7280"
                                         TextWrapping="Wrap" />
                                <TextBox Text="{Binding MatchingModelsText, Mode=OneWay}"
                                         Margin="0,4,0,0"
                                         Padding="0"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#2563EB"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Expander x:Name="ErrorsExpander"
                  Grid.Row="3"
                  Margin="0,8,0,0"
                  Header="查询失败"
                  Visibility="Collapsed">
            <TextBox x:Name="ErrorsTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MaxHeight="120"
                     Foreground="#DC2626"
                     VerticalScrollBarVisibility="Auto" />
        </Expander>
    </Grid>
</Window>
