<Window x:Class="WPF.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:APISwitch.Models;assembly=Core"
        Title="Prompt 收藏夹"
        Width="760"
        Height="560"
        MinWidth="600"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="PromptActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="PromptCopyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PromptActionButtonStyle}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="PromptDeleteButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PromptActionButtonStyle}">
            <Setter Property="Foreground" Value="#DC2626" />
        </Style>
    </Window.Resources>

    <Grid Margin="16" Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Prompt 收藏夹"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       VerticalAlignment="Center" />
            <Button x:Name="AddPromptButton"
                    Grid.Column="1"
                    Width="88"
                    Height="36"
                    Click="AddPromptButton_Click">新增</Button>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PromptItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:PromptItem}">
                            <Border Margin="0,0,0,10"
                                    Padding="16"
                                    Background="White"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBox Text="{Binding Content}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="64"
                                             MaxHeight="220"
                                             Padding="0"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalScrollBarVisibility="Auto" />

                                    <StackPanel Grid.Row="1"
                                                Margin="0,12,0,0"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Style="{StaticResource PromptCopyButtonStyle}"
                                                Click="CopyPromptButton_Click">复制</Button>
                                        <Button Style="{StaticResource PromptActionButtonStyle}"
                                                Margin="8,0,0,0"
                                                Click="EditPromptButton_Click">编辑</Button>
                                        <Button Style="{StaticResource PromptDeleteButtonStyle}"
                                                Margin="8,0,0,0"
                                                Click="DeletePromptButton_Click">删除</Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyPromptTextBlock"
                       Text="暂无 Prompt"
                       Visibility="Collapsed"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
