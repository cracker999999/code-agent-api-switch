<Window x:Class="WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:APISwitch.Models;assembly=Core"
        mc:Ignorable="d"
        Title="APISwitch"
        Height="640"
        Width="900"
        MinWidth="720"
        MinHeight="460"
        AllowDrop="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="RoundedTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TestStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Fill" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TestStatus}" Value="1">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Fill" Value="#22C55E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TestStatus}" Value="2">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Fill" Value="#EF4444" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16" Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="CodexTabButton"
                        Style="{StaticResource RoundedTabButtonStyle}"
                        Width="120"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="CodexTabButton_Click"
                        >Codex</Button>
                <Button x:Name="ClaudeTabButton"
                        Style="{StaticResource RoundedTabButtonStyle}"
                        Width="120"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="ClaudeTabButton_Click">Claude Code</Button>
                <Button x:Name="GrokTabButton"
                        Style="{StaticResource RoundedTabButtonStyle}"
                        Width="120"
                        Height="36"
                        Click="GrokTabButton_Click">Grok</Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SessionManagerButton"
                        Style="{StaticResource RoundedAddButtonStyle}"
                        Width="88"
                        Height="38"
                        Margin="0,0,8,0"
                        FontSize="12"
                        Click="SessionManagerButton_Click">会话管理</Button>
                <Button x:Name="PromptButton"
                        Style="{StaticResource RoundedAddButtonStyle}"
                        Width="70"
                        Height="38"
                        Margin="0,0,8,0"
                        FontSize="12"
                        Click="PromptButton_Click">Prompt</Button>
                <Button x:Name="SettingsButton"
                        Style="{StaticResource RoundedAddButtonStyle}"
                        Width="38"
                        Height="38"
                        Margin="0,0,8,0"
                        FontSize="16"
                        ToolTip="设置"
                        Click="SettingsButton_Click">⚙</Button>
                <Button x:Name="AddProviderButton"
                        Style="{StaticResource RoundedAddButtonStyle}"
                        Width="38"
                        Height="38"
                        FontSize="22"
                        Click="AddProviderButton_Click">+</Button>
            </StackPanel>
        </Grid>

        <TextBox Grid.Row="1"
                 x:Name="SearchTextBox"
                 Height="36"
                 Margin="0,0,0,12"
                 Padding="4,0,12,0"
                 FontSize="14"
                 VerticalContentAlignment="Center"
                 TextChanged="SearchTextBox_TextChanged">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="#D1D5DB" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <TextBlock Text="搜索供应商..."
                                                   FontSize="14"
                                                   Foreground="#9CA3AF"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      VerticalAlignment="Center"
                                                      Focusable="False" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>

        <ScrollViewer Grid.Row="2"
                      x:Name="ProvidersScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Hidden"
                      Padding="0"
                      Margin="0">
            <ItemsControl x:Name="ProvidersItemsControl" Margin="0,0,4,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Provider}">
                        <Border x:Name="ProviderCard"
                                Margin="0,0,2,10"
                                Padding="14"
                                Background="White"
                                CornerRadius="10"
                                MouseLeftButtonDown="ProviderCard_MouseLeftButtonDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#D1D5DB" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="#2563EB" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="☰"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           Foreground="#9CA3AF"
                                           FontSize="16"
                                           Cursor="SizeAll"
                                           PreviewMouseLeftButtonDown="ProviderDragHandle_PreviewMouseLeftButtonDown"
                                           PreviewMouseMove="ProviderDragHandle_PreviewMouseMove"
                                           PreviewMouseLeftButtonUp="ProviderDragHandle_PreviewMouseLeftButtonUp"
                                           LostMouseCapture="ProviderDragHandle_LostMouseCapture" />

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource TestStatusDotStyle}" />
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />
                                        <TextBlock Margin="8,0,0,0"
                                                   Text="{Binding Remark}"
                                                   FontSize="11"
                                                   Foreground="#9CA3AF"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Remark}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Remark}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock FontSize="12" Foreground="#6B7280">
                                            <Hyperlink Click="BaseUrlHyperlink_Click">
                                                <Run Text="{Binding BaseUrl}" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="{Binding TestModelDisplay}"
                                                   Margin="12,0,0,0"
                                                   Foreground="#9CA3AF"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="ActivateProviderButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                <Setter Property="Content" Value="启用" />
                                                <Setter Property="IsEnabled" Value="True" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Content" Value="使用中" />
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="TestProviderButton_Click">测试</Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="EditProviderButton_Click">编辑</Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Click="DeleteProviderButton_Click">删除</Button>
                                    <Button Style="{StaticResource ActionButtonStyle}"
                                            Click="MoveProviderUpButton_Click"
                                            IsEnabled="{Binding CanMoveUp}">↑</Button>
                                    <Button Style="{StaticResource ActionButtonStyle}"
                                            Click="MoveProviderDownButton_Click"
                                            IsEnabled="{Binding CanMoveDown}">↓</Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 拖拽时显示供应商的插入位置，不参与命中测试。 -->
        <Border Grid.Row="2"
                x:Name="ProviderDropInsertionIndicator"
                Height="2"
                Margin="2,0,18,0"
                VerticalAlignment="Top"
                Background="#2563EB"
                IsHitTestVisible="False"
                Panel.ZIndex="10"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ProviderDropIndicatorTransform" />
            </Border.RenderTransform>
        </Border>
    </Grid>
</Window>
